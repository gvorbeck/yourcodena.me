VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: reCAPTCHA Enterprise site key. Turns on App Check (enable it in the Firebase console, then enforce for Firestore).
VITE_APPCHECK_SITE_KEY=
# Optional, dev only: an App Check debug token (Firebase console → App Check → Apps → Manage debug tokens) so `npm run dev` can use production data once App Check is enforced.
VITE_APPCHECK_DEBUG_TOKEN=
